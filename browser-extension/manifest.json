{
  "manifest_version": 3,
  "name": "ShadowReply AI",
  "version": "1.1.0",
  "description": "Génère 3 réponses stratégiques directement depuis n'importe quelle page. Insérez la réponse en un clic.",
  "author": "ShadowReply AI",

  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "tabs",
    "clipboardWrite"
  ],

  "host_permissions": [
    "<all_urls>",
    "https://shadowreply-ai.vercel.app/*"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ShadowReply AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/widget.js"],
      "css": ["content/widget.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "extension@shadowreply.ai",
      "strict_min_version": "109.0"
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/*", "content/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
